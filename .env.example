# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key, used by the matching engine to read/write across
# users. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the matching engine's scheduled cron endpoint
# (POST /api/cron/process-matches). Generate any long random string.
CRON_SECRET=change-me-to-a-long-random-string
