# MySQL connection (hosted on Plesk). Never commit real values —
# this file only documents which variables are needed; put the real
# ones in .env.local (gitignored) or the Plesk Node.js panel's
# "Custom environment variables".
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=marryme

# NextAuth.js. Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=change-me-to-a-long-random-string
# Your production URL — set this once you have a domain (Plesk sits
# behind its own reverse proxy, so this avoids relying solely on the
# trustHost fallback in src/lib/auth.ts).
AUTH_URL=https://marryme.sg

# Shared secret for the matching engine's scheduled cron endpoint
# (POST /api/cron/process-matches). Generate any long random string.
CRON_SECRET=change-me-to-a-long-random-string

# Where uploaded profile photos are stored on disk. MUST be an
# absolute path outside this deployment folder in production — this
# repo builds with output: "standalone" (see next.config.ts), which
# regenerates .next from scratch on every build, so anything stored
# under it (or under public/) would be deleted on the next deploy.
# e.g. /var/www/marryme-uploads on Plesk. For local dev, a relative
# path like ./storage/uploads is fine.
UPLOADS_DIR=./storage/uploads

# Google Cloud Vision API key, used to moderate uploaded photos
# (SafeSearch + face detection) before they're saved — see
# src/lib/moderation.ts. Without this, uploads are NOT screened for
# inappropriate content (a warning is logged on every upload until
# it's set). A photo Vision flags is still saved but held invisible
# until an admin approves it in /admin/photos — see
# src/app/api/photos/upload/route.ts.
GOOGLE_CLOUD_VISION_API_KEY=

# Founding-member free access, auto-granted on first profile
# completion — see the homepage banner and /admin/memberships.
# Set to "false" once launch access should stop being granted to new
# signups (existing founding members keep whatever expiry they were
# given; this only controls new grants).
FOUNDING_ACCESS_ENABLED=true
# How many days of free access a new founding member gets. An admin
# can extend, shorten, or convert any individual member's access in
# /admin/memberships regardless of this default.
FOUNDING_ACCESS_DAYS=180
